{
  "rules": {
    ".read": false,
    ".write": false,

    "products": {
      ".read": true,
      ".write": "auth != null && auth.uid === 'xcKzNPzs3mhh711A5IcOE2d9HO53'",
      "$productId": {
        ".validate": "newData.hasChildren(['name', 'category', 'price', 'createdAt'])",
        "name": { ".validate": "newData.isString() && newData.val().length <= 150" },
        "slug": { ".validate": "newData.isString() && newData.val().length <= 200" },
        "category": { ".validate": "newData.isString() && newData.val().length <= 50" },
        "price": { ".validate": "newData.isNumber() && newData.val() >= 0" },
        "oldPrice": { ".validate": "newData.isNumber() && newData.val() >= 0" },
        "description": { ".validate": "newData.isString() && newData.val().length <= 1000" },
        "format": { ".validate": "newData.isString() && newData.val().length <= 100" },
        "delay": { ".validate": "newData.isString() && newData.val().length <= 50" },
        "stock": { ".validate": "newData.val() == 'Disponible' || newData.val() == 'Sur commande' || newData.val() == 'Épuisé'" },
        "featured": { ".validate": "newData.isBoolean()" },
        "isNew": { ".validate": "newData.isBoolean()" },
        "image": { ".validate": "newData.isString()" },
        "publicId": { ".validate": "newData.isString()" },
        "createdAt": { ".validate": "newData.isNumber()" },
        "updatedAt": { ".validate": "newData.isNumber()" },
        "$other": { ".validate": false }
      }
    },

    "productLikes": {
      ".read": true,
      "$productId": {
        "$visitorId": {
          ".write": "root.child('products').child($productId).exists() && $visitorId.length <= 64",
          ".validate": "newData.val() == true"
        }
      }
    },

    "orders": {
      ".read": "auth != null && auth.uid === 'xcKzNPzs3mhh711A5IcOE2d9HO53'",
      "$orderId": {
        ".write": "(auth != null && auth.uid === 'xcKzNPzs3mhh711A5IcOE2d9HO53') || (!data.exists() && newData.exists())",
        ".validate": "newData.hasChildren(['clientName', 'clientPhone', 'product', 'quantity', 'total', 'status', 'createdAt', 'paymentMode', 'paymentAmount', 'paymentStatus', 'remaining']) && ((auth != null && auth.uid === 'xcKzNPzs3mhh711A5IcOE2d9HO53') || (newData.child('status').val() == 'pending' && newData.child('paymentStatus').val() == 'pending'))",
        "clientName": { ".validate": "newData.isString() && newData.val().length <= 150" },
        "clientPhone": { ".validate": "newData.isString() && newData.val().length <= 30" },
        "clientEmail": { ".validate": "newData.isString() && newData.val().length <= 254" },
        "clientAddress": { ".validate": "newData.isString() && newData.val().length <= 300" },
        "product": { ".validate": "newData.isString() && newData.val().length <= 200" },
        "category": { ".validate": "newData.isString() && newData.val().length <= 50" },
        "quantity": { ".validate": "newData.isNumber() && newData.val() > 0" },
        "format": { ".validate": "newData.isString() && newData.val().length <= 200" },
        "style": { ".validate": "newData.isString() && newData.val().length <= 200" },
        "customText": { ".validate": "newData.isString() && newData.val().length <= 200" },
        "delivery": { ".validate": "newData.isString() && newData.val().length <= 200" },
        "deliveryDate": { ".validate": "newData.isString() && newData.val().length <= 50" },
        "notes": { ".validate": "newData.isString() && newData.val().length <= 1000" },
        "total": { ".validate": "newData.isNumber() && newData.val() >= 0" },
        "status": { ".validate": "newData.val() == 'pending' || newData.val() == 'confirmed' || newData.val() == 'progress' || newData.val() == 'delivered' || newData.val() == 'cancelled'" },
        "createdAt": { ".validate": "newData.isNumber()" },
        "files": { ".validate": "newData.hasChildren() || !newData.exists()" },

        "paymentMode": { ".validate": "newData.val() == 'deposit' || newData.val() == 'full'" },
        "paymentAmount": { ".validate": "newData.isNumber() && newData.val() >= 0" },
        "paymentStatus": { ".validate": "newData.val() == 'pending' || newData.val() == 'paid' || newData.val() == 'failed'" },
        "paymentDiscount": { ".validate": "newData.isNumber() && newData.val() >= 0" },
        "remaining": { ".validate": "newData.isNumber() && newData.val() >= 0" },
        "paymentReference": { ".validate": "newData.isString() && newData.val().length <= 100" },
        "paymentNote": { ".validate": "newData.isString() && newData.val().length <= 300" },
        "paymentConfirmedAt": { ".validate": "newData.isNumber()" },

        "updatedAt": { ".validate": "newData.isNumber()" },
        "$other": { ".validate": false }
      }
    },

    "contacts": {
      ".read": "auth != null && auth.uid === 'xcKzNPzs3mhh711A5IcOE2d9HO53'",
      "$contactId": {
        ".write": "(auth != null && auth.uid === 'xcKzNPzs3mhh711A5IcOE2d9HO53') || (!data.exists() && newData.exists())",
        ".validate": "newData.hasChildren(['name', 'message', 'createdAt', 'status']) && ((auth != null && auth.uid === 'xcKzNPzs3mhh711A5IcOE2d9HO53') || newData.child('status').val() == 'new')",
        "name": { ".validate": "newData.isString() && newData.val().length <= 100" },
        "email": { ".validate": "newData.isString() && newData.val().length <= 254" },
        "phone": { ".validate": "newData.isString() && newData.val().length <= 30" },
        "projectType": { ".validate": "newData.isString() && newData.val().length <= 100" },
        "message": { ".validate": "newData.isString() && newData.val().length <= 3000" },
        "createdAt": { ".validate": "newData.isNumber()" },
        "status": { ".validate": "newData.val() == 'new' || newData.val() == 'read' || newData.val() == 'replied'" },
        "$other": { ".validate": false }
      }
    },

    "admin_logs": {
      ".read": "auth != null && auth.uid === 'xcKzNPzs3mhh711A5IcOE2d9HO53'",
      "$logId": {
        ".write": "auth != null && auth.uid === 'xcKzNPzs3mhh711A5IcOE2d9HO53' && !data.exists()"
      }
    },

    "settings": {
      ".read": true,
      ".write": "auth != null && auth.uid === 'xcKzNPzs3mhh711A5IcOE2d9HO53'"
    }
  }
}
